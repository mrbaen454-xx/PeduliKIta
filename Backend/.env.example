PORT=5000
# Neon pooled connection (runtime queries, pgbouncer)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.neon.tech/neondb?sslmode=require&pgbouncer=true
# Neon direct connection (migrate deploy only, non-pooler)
DIRECT_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
JWT_SECRET=
JWT_EXPIRES_IN=1d
FRONTEND_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
