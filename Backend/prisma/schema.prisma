generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CAMPAIGNER
  DONOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CampaignStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  COMPLETED
  CLOSED
}

enum DonationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  phone      String?
  role       Role     @default(DONOR)
  status     UserStatus @default(ACTIVE)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  campaigns  Campaign[]
  donations  Donation[]

  @@map("users")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  status      String   @default("ACTIVE")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  campaigns   Campaign[]

  @@map("categories")
}

model Campaign {
  id               Int      @id @default(autoincrement())
  campaigner_id    Int
  category_id      Int
  title            String
  slug             String   @unique
  description      String   @db.Text
  target_amount    Decimal  @db.Decimal(15, 2)
  collected_amount Decimal  @default(0) @db.Decimal(15, 2)
  start_date       DateTime?
  end_date         DateTime
  image_url        String?
  status           CampaignStatus @default(PENDING)
  rejection_reason String?  @db.Text
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  campaigner       User     @relation(fields: [campaigner_id], references: [id])
  category         Category @relation(fields: [category_id], references: [id])

  updates          CampaignUpdate[]
  documents        CampaignDocument[]
  donations        Donation[]

  @@map("campaigns")
}

model Donation {
  id           Int      @id @default(autoincrement())
  campaign_id  Int
  donor_id     Int
  amount       Decimal  @db.Decimal(15, 2)
  message      String?  @db.Text
  is_anonymous Boolean  @default(false)
  proof_url    String
  status       DonationStatus @default(PENDING)
  donated_at   DateTime @default(now())
  verified_at  DateTime?

  campaign     Campaign @relation(fields: [campaign_id], references: [id])
  donor        User     @relation(fields: [donor_id], references: [id])

  @@map("donations")
}

model CampaignUpdate {
  id          Int      @id @default(autoincrement())
  campaign_id Int
  title       String
  content     String   @db.Text
  image_url   String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  campaign    Campaign @relation(fields: [campaign_id], references: [id])

  @@map("campaign_updates")
}

model CampaignDocument {
  id          Int      @id @default(autoincrement())
  campaign_id Int
  file_name   String
  file_url    String
  file_type   String
  created_at  DateTime @default(now())

  campaign    Campaign @relation(fields: [campaign_id], references: [id])

  @@map("campaign_documents")
}
